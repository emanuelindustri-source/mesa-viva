{
  "name": "mesa-viva",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "description": "Mesa Viva: juego de cartas y mesa con alma venezolana. Offline-first, multijugador, multilingüe.",
  "license": "MIT",
  "author": "Emanuel Industri",
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuelindustri-source/mesa-viva.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build && node tools/build-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rooms": "node server/room-server.mjs",
    "test:relay": "node tools/test-rejoin.mjs",
    "icons": "python tools/make_icons.py",
    "android:sync": "node tools/sync-android.mjs",
    "android:build": "npm run build && npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.1",
    "@fontsource/outfit": "^5.1.1",
    "framer-motion": "^14.6.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/lz-string": "^1.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}

