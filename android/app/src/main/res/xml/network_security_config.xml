<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- La app funciona offline desde assets locales. Para salas LAN se permite
         ws:// en la red local; en producción usa siempre wss://. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
