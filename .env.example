# Relay de salas en línea (WebSocket). En producción usa wss:// con TLS.
# Ejemplo local:
VITE_ROOM_WS_URL=ws://localhost:9001
# Ejemplo producción (Render/Fly/Railway):
# VITE_ROOM_WS_URL=wss://mesa-viva-room.onrender.com

# Envío automático opcional del diagnóstico (Formspree, FormSubmit o endpoint propio).
# Si está vacío, el botón abre el correo manual con el informe.
# Ejemplo: VITE_DIAGNOSTICS_ENDPOINT=https://formspree.io/f/TU_FORMULARIO
VITE_DIAGNOSTICS_ENDPOINT=
